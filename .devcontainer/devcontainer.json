{
  "name": "Trip Recap",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "updateContentCommand": "npm ci --ignore-scripts",
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "Trip Recap",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000]
}
